org.sh03.cannotSubmitFormError.title = You cannot submit this form
org.sh03.cannotSubmitFormError.heading = You cannot submit this form
org.sh03.cannotSubmitFormError.p1 = Only employees in the following roles in the purchasing company are able to submit information about a share buyback to HMRC:
org.sh03.cannotSubmitFormError.item1 = Director
org.sh03.cannotSubmitFormError.item2 = Secretary
org.sh03.cannotSubmitFormError.item3 = Person authorised under section 270 or 274 of the Companies Act 2026
org.sh03.cannotSubmitFormError.item4 = Administrator
org.sh03.cannotSubmitFormError.item5 = Receiver
org.sh03.cannotSubmitFormError.item6 = Receiver manager
org.sh03.cannotSubmitFormError.item7 = CIC manager
org.sh03.cannotSubmitFormError.item8 = Someone submitting on behalf of a UK Societas (UKS)

