agent.sh03.chargingPoint.error.required.two = The charging point for this share buyback must include a {0} and a {1}
agent.sh03.chargingPoint.error.required = The charging point for this share buyback must include a {0}
agent.sh03.chargingPoint.error.invalid = The charging point for this share buyback must be a real date
agent.sh03.chargingPoint.error.futureDate = The charging point for this share buyback must be today’s date, or a date in the past
agent.sh03.chargingPoint.change.hidden = Change the charging point

