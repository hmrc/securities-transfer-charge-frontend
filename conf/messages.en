chargingPoint.hint = This is also called the charging point. For example, 27 3 2024
chargingPoint.checkYourAnswersLabel = When did you buy the securities?
chargingPoint.error.required.all = Enter the date you bought these securities
chargingPoint.error.required.two = The date you bought the securities must include {0} and {1}
chargingPoint.error.required = The date you bought the securities must include a {0}
chargingPoint.error.invalid = The date you bought the securities must be a real date
chargingPoint.error.futureDate = The day you bought the securities must be today’s date or a date in the past
chargingPoint.change.hidden = ChargingPoint

taxRate.title = Tax rate
taxRate.heading = Tax rate
taxRate.p1 = For most securities transfers, you will be charged a tax rate of 0.5% of the consideration.
taxRate.p2 = If the securities are being transferred into a ‘depository receipt scheme’ or a ‘clearance service’, you will need to pay the 1.5% tax rate in most circumstances. This is usually where the transfer is not integral to capital raising or where the clearance service has elected to remain in the 0.5% regime.
taxRate.legend = What is the tax rate for this transfer?
taxRate.half = 0.5%
taxRate.oneAndHalf = 1.5%
taxRate.checkYourAnswersLabel = Tax rate
taxRate.error.required = Select a tax rate
taxRate.change.hidden = TaxRate

