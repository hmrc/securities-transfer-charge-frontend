sectionTitle.transferDetails = Transfer details
connectedPersons.title = Connected persons
connectedPersons.heading = Connected persons
connectedPersons.legend = Are you and the seller of these securities connected?
connectedPersons.checkYourAnswersLabel = Connected persons
connectedPersons.error.required = Select yes if you and the seller are ‘connected persons’
connectedPersons.p = We need to know if you and the seller of these securities are considered ‘connected persons’ for tax purposes. Connected persons include spouses, civil partners and close relatives.
connectedPersons.details.summary = Read more about connected persons
connectedPersons.details.content.p1 = You are considered connected with the following people:
connectedPersons.details.content.l1 = your husband, wife or civil partner
connectedPersons.details.content.l2 = your relatives and their husbands, wives or civil partners
connectedPersons.details.content.l3 = your husband’s, wife’s or civil partner’s relatives and their husbands, wives or civil partners
connectedPersons.details.content.l4 = the trustees of a settlement of which you are a settlor, or of which a person who is still alive and who is connected with you is a settlor
connectedPersons.details.content.p2 = Relative means a brother, sister, ancestor or descendant. It does not include nephews, nieces, uncles and aunts.
connectedPersons.details.content.link.text = Read HMRC guidance on connected persons

