POST       /stf/change/seller-name                  uk.gov.hmrc.securitiestransferchargefrontend.controllers.NameOfSellerController.onSubmit(mode: Mode = CheckMode)

GET        /stf/connected-persons                        uk.gov.hmrc.securitiestransferchargefrontend.controllers.ConnectedPersonsController.onPageLoad(mode: Mode = NormalMode)
